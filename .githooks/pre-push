#!/bin/sh
set -e

ROOT="$(git rev-parse --show-toplevel)"
APP="$ROOT/apps/crm-app"

echo "🔍 ESLint..."
(cd "$APP" && npm run lint)

echo "🔍 TypeScript..."
# Supprime les types Next.js générés localement (potentiellement obsolètes)
# pour reproduire l'état CI où .next/ n'existe pas.
rm -rf "$APP/.next/types"
(cd "$APP" && npx tsc --noEmit)
