# ─── Base de données ──────────────────────────────────────────────────────────
# Prod / Vercel : setter uniquement DATABASE_URL (TEST_DATABASE_URL non requis)
DATABASE_URL=postgresql://user:password@host:5432/crm_prod

# Local dev uniquement
TEST_DATABASE_URL=postgresql://lx:root@localhost:5441/crm_test
# SHADOW_DATABASE_URL=postgresql://lx:password@localhost:5441/crm_shadow  # optionnel, pour prisma migrate dev

# ─── Auth ─────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=https://your-app.vercel.app

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ─── APIs externes ────────────────────────────────────────────────────────────
SIRENE_API_KEY=your-sirene-api-key
